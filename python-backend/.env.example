# OpenAI-compatible model API. Leave empty to use the local grounded fallback.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Optional failover model.
SECONDARY_LLM_API_KEY=
SECONDARY_LLM_BASE_URL=
SECONDARY_LLM_MODEL=

# OpenAI-compatible Embedding API. Empty uses the deterministic local embedding.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=384
VECTOR_STORE_PATH=./data/qdrant
VECTOR_COLLECTION=product_knowledge

# Dedicated rerank API. Empty uses the local feature reranker.
RERANK_API_KEY=
RERANK_URL=https://api.siliconflow.cn/v1/rerank
RERANK_MODEL=BAAI/bge-reranker-v2-m3

QUERY_REWRITE_ENABLED=true
RETRIEVAL_TOP_K=5
RRF_K=60
AGENT_MAX_STEPS=5
MAX_CONTEXT_CHARS=10000
SEED_DEMO_DATA=true

