# OpenAI-compatible model API. Leave empty to use the local grounded fallback.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Optional failover model.
SECONDARY_LLM_API_KEY=
SECONDARY_LLM_BASE_URL=
SECONDARY_LLM_MODEL=

QUERY_REWRITE_ENABLED=true
RETRIEVAL_TOP_K=5
MAX_CONTEXT_CHARS=10000
SEED_DEMO_DATA=true

